# Reference data: auto (live API, snapshot fallback) | live | cache
PA_DATA_MODE=auto
# LLM: none (deterministic rule-based mode) | openai | anthropic
LLM_PROVIDER=none
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Tools run in an MCP server subprocess (mcp) or in-process (inprocess, for tests)
PA_TOOL_TRANSPORT=mcp
# Chaos testing: probability that a tool call's first attempt fails (0 - 1)
PA_FAULT_RATE=0
